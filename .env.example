# Copy to .env for local dev; set the same keys as Netlify env vars in production.
#
# Anything prefixed VITE_ is compiled into the bundle every member downloads.
# The anon key is meant to be public — row-level security is what protects the
# data, not the key. Nothing else belongs behind that prefix.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only: read by netlify/functions/draft-primer.mjs, never by the
# app. Set these in Netlify → Site configuration → Environment variables.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security entirely — it can read
# and write every table whatever the policies say. That's why the function
# needs it, and why it must never gain a VITE_ prefix or reach git. If it ever
# does, rotate it in Supabase straight away.
#
# See netlify/functions/README.md.
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
